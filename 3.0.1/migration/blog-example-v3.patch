+from django.contrib.auth.hashers import check_password
 from django.test import TestCase
 
-# Create your tests here.
+from api.models import Author, Category, Comment, Post, Tag
+
+
+class BlogMigrationTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.author = Author.objects.create(
+            first_name="Ada",
+            last_name="Lovelace",
+            username="ada",
+            email="ada@example.com",
+            password="old-password",
+        )
+        cls.other = Author.objects.create(
+            first_name="Grace",
+            last_name="Hopper",
+            username="grace",
+            email="grace@example.com",
+            password="other-password",
+        )
+        cls.post = Post.objects.create(
+            author=cls.author, title="Owned post", content="Original"
+        )
+        cls.other_post = Post.objects.create(
+            author=cls.other, title="Other post", content="Private"
+        )
+        cls.tag = Tag.objects.create(name="django")
+        cls.category = Category.objects.create(name="Programming")
+
+    def headers(self, *, refresh=False):
+        token = (
+            self.author.create_refresh_token()
+            if refresh
+            else self.author.create_access_token()
+        )
+        return {"Authorization": f"Bearer {token}"}
+
+    async def test_signup_hashes_the_password_and_returns_public_fields(self):
+        response = await self.async_client.post(
+            "/api/authors",
+            data={
+                "first_name": "Linus",
+                "last_name": "Torvalds",
+                "username": "linus",
+                "email": "linus@example.com",
+                "password": "signup-password",
+            },
+            content_type="application/json",
+        )
+        self.assertEqual(response.status_code, 201, response.content)
+        self.assertNotIn("password", response.json())
+        author = await Author.objects.aget(username="linus")
+        self.assertTrue(check_password("signup-password", author.password))
+
+    async def test_anonymous_login_and_refresh(self):
+        login = await self.async_client.post(
+            "/api/login",
+            data={"username": "ada", "password": "old-password"},
+            content_type="application/json",
+        )
+        self.assertEqual(login.status_code, 200, login.content)
+        me = await self.async_client.get(
+            "/api/authors/me",
+            headers={"Authorization": f"Bearer {login.json()['access_token']}"},
+        )
+        self.assertEqual(me.status_code, 200, me.content)
+        self.assertEqual(me.json()["username"], "ada")
+        refresh = await self.async_client.post(
+            "/api/login/refresh", headers=self.headers(refresh=True)
+        )
+        self.assertEqual(refresh.status_code, 200, refresh.content)
+        self.assertIn("access_token", refresh.json())
+
+    async def test_bad_password_and_missing_token_are_rejected(self):
+        bad = await self.async_client.post(
+            "/api/login",
+            data={"username": "ada", "password": "wrong"},
+            content_type="application/json",
+        )
+        self.assertEqual(bad.status_code, 401)
+        missing = await self.async_client.get("/api/posts")
+        self.assertEqual(missing.status_code, 401)
+
+    async def test_patch_preserves_unsent_fields_and_duplicate_signup_is_a_conflict(
+        self,
+    ):
+        patch = await self.async_client.patch(
+            f"/api/authors/{self.author.pk}",
+            data={"first_name": "Augusta"},
+            content_type="application/json",
+            headers=self.headers(),
+        )
+        self.assertEqual(patch.status_code, 200, patch.content)
+        self.assertEqual(patch.json()["full_name"], "Augusta Lovelace")
+        duplicate = await self.async_client.post(
+            "/api/authors",
+            data={
+                "first_name": "Ada",
+                "last_name": "Lovelace",
+                "username": "ada",
+                "email": "duplicate@example.com",
+                "password": "x",
+            },
+            content_type="application/json",
+        )
+        self.assertEqual(duplicate.status_code, 409, duplicate.content)
+
+    async def test_posts_accept_fk_spellings_and_custom_lists_keep_owner_scope(self):
+        for field in ("author", "author_id"):
+            response = await self.async_client.post(
+                "/api/posts",
+                data={field: str(self.author.pk), "title": field, "content": "body"},
+                content_type="application/json",
+                headers=self.headers(),
+            )
+            self.assertEqual(response.status_code, 201, response.content)
+        for endpoint in (
+            "/api/posts",
+            "/api/posts/by-me",
+            f"/api/posts/by-author/{self.author.pk}",
+        ):
+            response = await self.async_client.get(endpoint, headers=self.headers())
+            self.assertEqual(response.status_code, 200, response.content)
+            self.assertEqual(response.json()["count"], 3)
+            self.assertNotIn(
+                "Other post", [item["title"] for item in response.json()["items"]]
+            )
+        hidden = await self.async_client.get(
+            f"/api/posts/{self.other_post.pk}", headers=self.headers()
+        )
+        self.assertEqual(hidden.status_code, 404)
+
+    async def test_m2m_and_comments_survive_the_migration(self):
+        response = await self.async_client.post(
+            f"/api/posts/{self.post.pk}/tags/",
+            data={"add": [str(self.tag.pk)]},
+            content_type="application/json",
+            headers=self.headers(),
+        )
+        self.assertEqual(response.status_code, 200, response.content)
+        self.assertTrue(await self.post.tags.filter(pk=self.tag.pk).aexists())
+        comment = await self.async_client.post(
+            "/api/comments",
+            data={
+                "author": str(self.author.pk),
+                "post": str(self.post.pk),
+                "content": "Nice",
+            },
+            content_type="application/json",
+            headers=self.headers(),
+        )
+        self.assertEqual(comment.status_code, 201, comment.content)
+        self.assertTrue(await Comment.objects.filter(content="Nice").aexists())
+
+    async def test_password_change_remains_usable_for_login(self):
+        change = await self.async_client.post(
+            "/api/login/change-password",
+            data={"old_password": "old-password", "new_password": "new-password"},
+            content_type="application/json",
+            headers=self.headers(),
+        )
+        self.assertEqual(change.status_code, 200, change.content)
+        author = await Author.objects.aget(pk=self.author.pk)
+        self.assertTrue(check_password("new-password", author.password))
+        login = await self.async_client.post(
+            "/api/login",
+            data={"username": "ada", "password": "new-password"},
+            content_type="application/json",
